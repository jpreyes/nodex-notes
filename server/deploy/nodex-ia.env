# Configuración del servidor de la IA incluida (ver server/README.md).
# Clave de la IA del servicio (OpenCode Zen u otro compatible con OpenAI).
NOTAS_IA_KEY=
NOTAS_IA_UPSTREAM=https://opencode.ai/zen/v1/
NOTAS_IA_MODEL=deepseek-v4.1-flash
# Tokens al mes por persona (entrada + salida).
NOTAS_IA_LIMITE=3000000
# USD por millón de tokens, para estimar el costo por persona (nodex-ia lista).
NOTAS_IA_PRECIO_ENTRADA=0.3
NOTAS_IA_PRECIO_SALIDA=1.2
# Cuentas nuevas: prueba de 14 días con 1 M de tokens al mes.
NOTAS_IA_PRUEBA_DIAS=14
NOTAS_IA_LIMITE_PRUEBA=1000000
# Correo de los códigos para entrar (Resend). Sin clave, el código queda en el registro.
NOTAS_IA_CORREO_CLAVE=
NOTAS_IA_CORREO_DE=Notas <hola@tudominio.cl>
# A quién avisar cuando alguien crea una cuenta (las cuentas nuevas esperan aprobación:
# nodex-ia pendientes / aprobar <correo> / rechazar <correo>).
NOTAS_IA_AVISAR=
NOTAS_IA_DATA=/var/lib/nodex-ia
NOTAS_IA_DIRECCION=127.0.0.1
NOTAS_IA_PUERTO=8080
